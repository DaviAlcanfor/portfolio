---
// Efeitos do mouse: rastro de caracteres caindo (igual à chuva do vídeo) e explosão no clique.
// A seta em si é um cursor nativo customizado (global.css), então nunca some — nem dentro do terminal.
// Só ativa com mouse (pointer: fine); em touch nada muda.
---

<script>
  import { GLYPHS } from '../lib/scramble'

  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

  if (fine && !reduced) {
    const STEP = 26 // px de movimento entre um caractere do rastro e outro
    const MAX_GLYPHS = 40
    let last = { x: 0, y: 0 }

    function spawn(x: number, y: number, cls: string, dx = 0, dy = 0) {
      if (document.querySelectorAll('.glyph').length >= MAX_GLYPHS) return
      const g = document.createElement('span')
      g.className = `glyph ${cls}`
      g.textContent = GLYPHS[(Math.random() * GLYPHS.length) | 0]
      g.style.left = `${x}px`
      g.style.top = `${y}px`
      g.style.setProperty('--dx', `${dx}px`)
      g.style.setProperty('--dy', `${dy}px`)
      g.addEventListener('animationend', () => g.remove())
      document.body.append(g)
    }

    addEventListener('mousemove', ({ clientX: x, clientY: y }) => {
      if (Math.hypot(x - last.x, y - last.y) > STEP) {
        spawn(x, y, 'trail')
        last = { x, y }
      }
    })

    addEventListener('mousedown', (e) => {
      for (let i = 0; i < 8; i++) {
        const angle = (i / 8) * Math.PI * 2
        spawn(e.clientX, e.clientY, 'burst', Math.cos(angle) * 40, Math.sin(angle) * 40)
      }
    })
  }
</script>

<style>
  /* rastro e explosão (criados via JS no body, por isso :global) */
  :global(.glyph) {
    position: fixed; z-index: 999;
    pointer-events: none;
    font-size: 12px; line-height: 1;
    color: var(--fg-hi);
    text-shadow: 0 0 8px rgb(255 182 39 / .8);
    transform: translate(-50%, -50%);
  }
  :global(.glyph.trail) { animation: fall .9s ease-in forwards; }
  :global(.glyph.burst) { animation: burst .6s ease-out forwards; }

  @keyframes fall {
    to { transform: translate(-50%, calc(-50% + 36px)); opacity: 0; }
  }
  @keyframes burst {
    to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))); opacity: 0; }
  }
</style>
