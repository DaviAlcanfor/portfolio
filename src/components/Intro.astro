---
import { SITE } from '../data/site'
---

<main class="intro">
  <div class="left">
    {/* <button class="projects" data-open-projects>&gt; ls projects <kbd>/</kbd></button> */}
    <h1 class="role glow" data-glitch data-roles={JSON.stringify(SITE.roles)}>{SITE.roles[0]}</h1>
  </div>
  <p class="bio glow" data-glitch>{SITE.bio}</p>
</main>

<script>
  import { scramble } from '../lib/scramble'

  const role = document.querySelector<HTMLElement>('.intro .role')!
  const bio = document.querySelector<HTMLElement>('.intro .bio')!
  const roles: string[] = JSON.parse(role.dataset.roles!)
  let current = 0

  // cargo: troca com glitch a cada 3s; bio: decodifica ao carregar
  scramble(role, roles[0])
  setInterval(() => scramble(role, roles[(current = (current + 1) % roles.length)]), 3000)
  scramble(bio, bio.textContent ?? '', 1800)
</script>

<style>
  .intro {
    position: fixed; inset: auto 0 0;
    display: flex; justify-content: space-between; align-items: flex-end;
    padding: 0 64px 48px; gap: 32px;
  }

  .left { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; }

  .projects { font-size: 14px; color: var(--fg); }
  kbd {
    margin-left: 6px; padding: 0 5px;
    font: inherit; font-size: 11px; color: var(--fg-dim);
    border: 1px solid var(--fg-dim); border-radius: 3px;
  }

  .role { font-size: 30px; font-weight: 400; letter-spacing: -.02em; cursor: default; min-height: 1.3em; }

  .bio {
    text-align: right; font-size: 18px; line-height: 1.5;
    color: var(--fg-dim); white-space: pre-line; cursor: default;
  }

  @media (max-width: 768px) {
    .intro { flex-direction: column; align-items: flex-start; padding: 0 16px 32px; gap: 16px; }
    .role { font-size: 20px; }
    kbd { display: none; } /* atalho de teclado não faz sentido no celular */
    .bio { text-align: left; font-size: 13px; }
  }
</style>
