---
import { ICONS, type IconName } from './icons'

interface Props {
  name: IconName
  size?: number
}

const { name, size = 22 } = Astro.props
---

<svg viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" set:html={ICONS[name]} />

<style>
  svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
